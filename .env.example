# vnbroker Environment Configuration Example
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control!

# =============================================================================
# DNSE (Định Nghĩa Securities) - HMAC OpenAPI
# Register at: https://developers.dnse.com.vn/
# Used for: Market data, Order API, Trading
# =============================================================================
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here
DNSE_ACCOUNT_NO=your_sub_account_no_here
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_MARKET_TYPE=STOCK

# DNSE JWT Trade Client (Trading / Account)
# Requires: DNSE trading account username/password
DNSE_USERNAME=your_dnse_username_here
DNSE_PASSWORD=your_dnse_password_here

# =============================================================================
# FMP (Financial Modeling Prep) - International Stock Data
# Register at: https://financialmodelingprep.com/developer/docs
# Used for: International quotes, financials, company profiles, news
# =============================================================================
FMP_API_KEY=your_fmp_api_key_here
# Alternative env var name (also supported)
# FMP_TOKEN=your_fmp_api_key_here

# =============================================================================
# TCBS (Techcombank Securities)
# Used for: Market data, Financial statements, Company info
# =============================================================================
TCBS_AUTH_TOKEN=your_tcbs_auth_token_here

# =============================================================================
# VCI (Viet Capital Securities)
# Used for: Market data, Financial statements, Company info
# =============================================================================
VCI_API_KEY=your_vci_api_key_here

# =============================================================================
# KBS (KIS Vietnam Securities)
# Used for: Market data, Financial statements, Company info
# =============================================================================
KBS_API_KEY=your_kbs_api_key_here

# =============================================================================
# MSN (Microsoft Finance / Bing News)
# Used for: International quotes, News
# =============================================================================
MSN_API_KEY=your_msn_api_key_here

# =============================================================================
# PAT (Personal Access Token) - Required for all modes
# Generate at: https://your-vnbroker-instance.com/settings/pat
# =============================================================================
VNBROKER_PAT=your_personal_access_token_here

# =============================================================================
# Optional: Redis/SQLite for Advanced Mode (metering, caching)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
# SQLITE_PATH=./data/metering.db

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO