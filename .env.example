# vnbroker Environment Configuration Example
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control!

# =============================================================================
# DNSE (Định Nghĩa Securities) - HMAC OpenAPI
# Register at: https://developers.dnse.com.vn/
# Used for: Market data, Order API, Trading
# =============================================================================
DNSE_API_KEY=your_dnse_api_key_here
DNSE_API_SECRET=your_dnse_api_secret_here
DNSE_ACCOUNT_NO=your_sub_account_no_here
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_MARKET_TYPE=STOCK

# DNSE JWT Trade Client (Trading / Account)
# Requires: DNSE trading account username/password
# ⚠️ CHƯA HỖ TRỢ: code không đọc 2 biến này; phần DNSE JWT/Trading chưa được implement (không có vnbroker/brokerage/dnse/).
DNSE_USERNAME=your_dnse_username_here
DNSE_PASSWORD=your_dnse_password_here

# =============================================================================
# TCBS (Techcombank Securities) - Broker Lane (iFlash OpenAPI v1.0.0)
# Used for: Private brokerage - account, balance, holdings, orders, portfolio
# =============================================================================
VNBROKER_BROKER_TCBS_API_KEY=your_tcbs_openapi_key_here
# Optional overrides:
# VNBROKER_BROKER_TCBS_BASE_URL=https://openapi.tcbs.com.vn
# VNBROKER_BROKER_TCBS_CUSTODY_CODE=105Cxxxxxx

# =============================================================================
# SSI (SSI Securities) - Broker Lane (native FastConnect v3, no ssi-sdk needed)
# Used for: Market data (no OTP), account/portfolio, orders, 7 FCO types, WS stream
# Register at: https://developers.ssi.com.vn/
# =============================================================================
VNBROKER_BROKER_SSI_CLIENT_ID=your_ssi_client_id_here
VNBROKER_BROKER_SSI_API_KEY=your_ssi_api_key_here
VNBROKER_BROKER_SSI_API_SECRET=your_ssi_api_secret_here
VNBROKER_BROKER_SSI_PRIVATE_KEY=your_ssi_base64_xml_rsa_private_key_here
# Optional overrides:
# VNBROKER_BROKER_SSI_API_URL=https://api.ssi.com.vn
# VNBROKER_BROKER_SSI_STREAM_URL=wss://stream.ssi.com.vn/ws/v3
# VNBROKER_BROKER_SSI_DEVICE_ID=A1:B2:C3:D4:E5:F6
# VNBROKER_BROKER_SSI_ACCOUNT_NO=your_sub_account_no_here
# VNBROKER_BROKER_SSI_TIMEOUT_SECONDS=60.0
# VNBROKER_BROKER_SSI_RATE_LIMIT_RPS=10
# VNBROKER_BROKER_SSI_MAX_RETRIES=5
# Router opt-in (P2, default 0 = AUTO giữ open-only):
# VNBROKER_SSI_AUTO_ENABLE=0

# =============================================================================
# Optional: Rate Limiting & Caching
# =============================================================================
# vnbroker_RATE_LIMIT_RPM=500
# vnbroker_LISTING_CACHE_TTL=86400
# vnbroker_INDUSTRY_CACHE_TTL=86400

# =============================================================================
# Optional: Trading Source Override
# =============================================================================
# vnbroker_TRADING_AUTO_PRIMARY=kbs  # or vci

# =============================================================================
# Logging
# =============================================================================
vnbroker_LOG_LEVEL=INFO