# DNSE integration environment sample
# Copy values into your shell environment before running tests.
#
# === LUỒNG 1: HMAC OpenAPI (Market Data + Order API) ===
# Yêu cầu: đăng ký tại https://developers.dnse.com.vn/ để lấy api_key và api_secret.
# Dùng với: Vnbroker().stock('VNM', source='DNSE', api_key=..., api_secret=...)
#           DNSEQuote('VNM', api_key=..., api_secret=...)
#           DNSEListing(api_key=..., api_secret=...)

DNSE_API_KEY=replace_with_dnse_api_key
DNSE_API_SECRET=replace_with_dnse_api_secret
DNSE_ACCOUNT_NO=replace_with_sub_account_no
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_MARKET_TYPE=STOCK

# === LUỒNG 2: JWT Trade Client (Trading / Account) ===
# Yêu cầu: tài khoản giao dịch DNSE, username/password đăng nhập app.
# Dùng với: Trade().login(username, password) → Trade().get_trading_token(otp)
#           Trade().login_and_get_trading_session(username, password, otp)

DNSE_USERNAME=replace_with_dnse_username
DNSE_PASSWORD=replace_with_dnse_password

# === FMP (Financial Modeling Prep) - International Stock Data ===
# Register at: https://financialmodelingprep.com/developer/docs
# Used for: International quotes, financials, company profiles, news
FMP_API_KEY=replace_with_fmp_api_key
# Alternative env var name (also supported)
# FMP_TOKEN=replace_with_fmp_api_key
